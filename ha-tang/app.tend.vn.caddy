# Tend mới (app.tend.vn) – tệp này được trien-khai.sh chép vào /etc/caddy/sites/.
# Caddyfile chính (của bản cũ) có dòng: import /etc/caddy/sites/*.caddy
app.tend.vn {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Tải bản vẽ DXF/ảnh lên tối đa 100 MB
	request_body {
		max_size 100MB
	}
	# Tệp giao diện do Caddy phục vụ trực tiếp; ảnh hiện trường/chứng từ đi qua app (có kiểm quyền)
	handle_path /static/* {
		root * /srv/tend-v2/app/staticfiles
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8002
	}
}
