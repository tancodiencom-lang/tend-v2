# Sao thành .env và điền giá trị thật (không commit .env).
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=app.tend.vn
CSRF_TRUSTED_ORIGINS=https://app.tend.vn
BEHIND_PROXY=True
DATABASE_URL=
MEDIA_ROOT=
APP_URL=https://app.tend.vn
# Bot Telegram (nhập liệu qua chat) và trợ lý AI
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
ANTHROPIC_API_KEY=
TEND_AI_MODEL=claude-haiku-5-5
TEND_AI_MONTHLY_USD=4
# Trợ lý nội dung (bài đăng): mô hình và trần chi phí riêng, không ảnh hưởng bot báo cáo (mặc định Sonnet 5.5, 30 USD/tháng)
TEND_MKT_AI_MODEL=claude-sonnet-5-5
TEND_MKT_AI_MONTHLY_USD=30

# Kho tài liệu gốc trên Google Drive (ha-tang/dong-bo-goc.sh): kho rclone + thư mục; "tat" = không chép lên Drive
TEND_GOC_DRIVE=
# Trợ lý: ngày làm việc (1 = thứ Hai … 7 = Chủ nhật)
TEND_WORK_DAYS=1,2,3,4,5,6

# Trợ lý nội dung số (đợt 10a). Khoá Meta (người dùng dài hạn hoặc khoá hệ thống Business) có quyền pages_manage_posts,
# pages_read_engagement, pages_show_list trên các Trang. Nhiều tài khoản Meta: thêm TEND_META_TOKEN_<TÊN> và ghi <TÊN> ở
# trang Nội dung › Kênh đăng. Không dán khoá vào chat.
TEND_META_TOKEN=
TEND_MKT_DAILY=1
# Thư mục Google Drive (kho rclone:đường dẫn, cách nhau bằng ;) để trợ lý xem ảnh thiết kế/ảnh công trình; "tat" = không kéo
TEND_MKT_DRIVE=
