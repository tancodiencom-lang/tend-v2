[Unit]
Description=Tend moi (app.tend.vn) - Django, gunicorn
After=network.target postgresql.service
Requires=postgresql.service
OnFailure=tend-canh-bao@%n.service

[Service]
User=tendv2
Group=tendv2
WorkingDirectory=/srv/tend-v2/app
ExecStart=/srv/tend-v2/app/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8002 --workers 2 --timeout 90 --access-logfile -
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
